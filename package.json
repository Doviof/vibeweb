    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
